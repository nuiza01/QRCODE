# Phase 1: no .env file or DATABASE_URL is needed for local generation, tests,
# plain CI build or npm run check:drift. QR payloads stay in the browser.
# Local development only. DO NOT copy this value to a deployment environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production: export the user-approved HTTPS public DNS origin in the BUILD
# environment before npm run build:release. No credentials/path/query/fragment,
# IP/internal/reserved hosts or non-default port. A runtime-only change is too late.
# Other providers must use build:release or NQR_DEPLOY_TARGET=production.
# NQR_DEPLOY_TARGET=production

# Vercel-managed hostname (not a URL required by the platform). Preview may use
# this fallback ONLY when NEXT_PUBLIC_APP_URL is absent, not blank/invalid/local.
# Never substitutes for the explicit production origin. No real domain selected here.
# VERCEL_PROJECT_PRODUCTION_URL=your-project.vercel.app

# Phase 2. Never expose these as NEXT_PUBLIC_* or commit secrets. Enter the
# real HostAtom MariaDB value directly in Plesk environment configuration.
# DATABASE_URL="DATABASE_URL="mysql://nqr_local@127.0.0.1:3307/nqr_local""
# NEXT_PUBLIC_SHORT_URL="http://localhost:3000"
# SCAN_IP_SALT=""  # Generate locally when Phase 2 is authorized.

# Google sign-in for Phase 2 accounts. It is enabled only when this complete
# set and DATABASE_URL are present. Since 2026-09-18 the generator itself is
# behind the account gate at /[locale]/create, so without these the app can
# serve its public pages but nobody can create a QR code: an environment that
# cannot check a session refuses rather than opening the generator.
# Never commit real values or expose secrets as NEXT_PUBLIC_*.
# BETTER_AUTH_URL="http://localhost:3000"
# BETTER_AUTH_SECRET=<set-in-local-env-only>
# GOOGLE_CLIENT_ID=<set-in-local-env-only>
# GOOGLE_CLIENT_SECRET=<set-in-local-env-only>
# Production callback: https://nqr.orenvis.com/api/auth/callback/google
